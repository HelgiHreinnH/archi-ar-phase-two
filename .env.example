# Frontend (client-safe). Copy to .env.local and fill in.
# The Supabase publishable key is designed to be public.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Spatial bake-off only (temporary): 8thwall | zappar | immersal. Leave unset on production.
VITE_LAB_ENGINE=
